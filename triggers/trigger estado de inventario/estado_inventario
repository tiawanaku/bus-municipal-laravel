DELIMITER //

CREATE TRIGGER tr_set_estado_inventario_talonarios
BEFORE INSERT ON inventario_talonarios
FOR EACH ROW
BEGIN
    DECLARE v_asignable_pref_exists INT DEFAULT 0;
    DECLARE v_asignable_reg_exists INT DEFAULT 0;
    DECLARE v_oldest_pref_id INT DEFAULT NULL;
    DECLARE v_oldest_reg_id INT DEFAULT NULL;
    
    -- Solo si hay talonarios disponibles
    IF NEW.cantidad_restante_preferencial > 0 OR NEW.cantidad_restante_regular > 0 THEN
        -- Gestión preferencial
        IF NEW.cantidad_restante_preferencial > 0 THEN
            -- Verificar existencia de talonario asignable con disponibilidad
            SELECT 1 INTO v_asignable_pref_exists
            FROM inventario_talonarios
            WHERE estado_preferencial = 1 
            AND cantidad_restante_preferencial > 0
            LIMIT 1;
            
            IF v_asignable_pref_exists = 1 THEN
                SET NEW.estado_preferencial = 2; -- Poner en espera
            ELSE
                -- Buscar el más antiguo en espera
                SELECT id INTO v_oldest_pref_id
                FROM inventario_talonarios
                WHERE estado_preferencial = 2 
                AND cantidad_restante_preferencial > 0
                ORDER BY created_at ASC
                LIMIT 1;
                
                IF v_oldest_pref_id IS NOT NULL THEN
                    -- Activar el más antiguo
                    UPDATE inventario_talonarios 
                    SET estado_preferencial = 1 
                    WHERE id = v_oldest_pref_id;
                    SET NEW.estado_preferencial = 2;
                ELSE
                    SET NEW.estado_preferencial = 1; -- Primer disponible
                END IF;
            END IF;
        ELSE
            SET NEW.estado_preferencial = 0;
        END IF;
        
        -- Gestión regular (misma lógica que preferencial)
        IF NEW.cantidad_restante_regular > 0 THEN
            SELECT 1 INTO v_asignable_reg_exists
            FROM inventario_talonarios
            WHERE estado_regular = 1 
            AND cantidad_restante_regular > 0
            LIMIT 1;
            
            IF v_asignable_reg_exists = 1 THEN
                SET NEW.estado_regular = 2;
            ELSE
                SELECT id INTO v_oldest_reg_id
                FROM inventario_talonarios
                WHERE estado_regular = 2 
                AND cantidad_restante_regular > 0
                ORDER BY created_at ASC
                LIMIT 1;
                
                IF v_oldest_reg_id IS NOT NULL THEN
                    UPDATE inventario_talonarios 
                    SET estado_regular = 1 
                    WHERE id = v_oldest_reg_id;
                    SET NEW.estado_regular = 2;
                ELSE
                    SET NEW.estado_regular = 1;
                END IF;
            END IF;
        ELSE
            SET NEW.estado_regular = 0;
        END IF;
    ELSE
        -- Sin disponibilidad
        SET NEW.estado_preferencial = 0;
        SET NEW.estado_regular = 0;
    END IF;
END //

DELIMITER ;