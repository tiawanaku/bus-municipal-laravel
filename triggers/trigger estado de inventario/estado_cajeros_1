DELIMITER //

-- Trigger BEFORE INSERT para manejar estados FIFO en entrega_talonarios
CREATE TRIGGER verificar_estados_talonarios_fifo
BEFORE INSERT ON entrega_talonarios
FOR EACH ROW
BEGIN
    DECLARE existe_activo_pref INT DEFAULT 0;
    DECLARE existe_activo_reg INT DEFAULT 0;
    DECLARE id_mas_antiguo_pref INT DEFAULT NULL;
    DECLARE id_mas_antiguo_reg INT DEFAULT NULL;

    -- Verificar registros activos preferenciales con disponibilidad
    SELECT COUNT(*) INTO existe_activo_pref
    FROM entrega_talonarios
    WHERE estado_preferencial = 1
    AND cantidad_restante_preferencial > 0;

    -- Verificar registros activos regulares con disponibilidad
    SELECT COUNT(*) INTO existe_activo_reg
    FROM entrega_talonarios
    WHERE estado_regular = 1
    AND cantidad_restante_regular > 0;

    -- Buscar el más antiguo con disponibilidad preferencial (FIFO por created_at)
    SELECT id INTO id_mas_antiguo_pref
    FROM entrega_talonarios
    WHERE cantidad_restante_preferencial > 0
    AND estado_preferencial != 1
    ORDER BY created_at ASC
    LIMIT 1;

    -- Buscar el más antiguo con disponibilidad regular (FIFO por created_at)
    SELECT id INTO id_mas_antiguo_reg
    FROM entrega_talonarios
    WHERE cantidad_restante_regular > 0
    AND estado_regular != 1
    ORDER BY created_at ASC
    LIMIT 1;

    -- Manejo de estados cuando no hay disponibilidad
    IF NEW.cantidad_restante_preferencial = 0 AND NEW.cantidad_restante_regular = 0 THEN
        SET NEW.estado_preferencial = 0;
        SET NEW.estado_regular = 0;
    ELSE
        -- Lógica FIFO para talonarios preferenciales
        IF NEW.cantidad_restante_preferencial > 0 THEN
            IF existe_activo_pref = 0 THEN
                IF id_mas_antiguo_pref IS NOT NULL THEN
                    -- Activar el más antiguo primero (FIFO)
                    UPDATE entrega_talonarios
                    SET estado_preferencial = 1
                    WHERE id = id_mas_antiguo_pref;
                    SET NEW.estado_preferencial = 2; -- Nuevo en espera
                ELSE
                    SET NEW.estado_preferencial = 1; -- Primer disponible
                END IF;
            ELSE
                SET NEW.estado_preferencial = 2; -- Espera (ya hay activo)
            END IF;
        ELSE
            SET NEW.estado_preferencial = 0; -- Sin disponibilidad
        END IF;

        -- Lógica FIFO para talonarios regulares
        IF NEW.cantidad_restante_regular > 0 THEN
            IF existe_activo_reg = 0 THEN
                IF id_mas_antiguo_reg IS NOT NULL THEN
                    -- Activar el más antiguo primero (FIFO)
                    UPDATE entrega_talonarios
                    SET estado_regular = 1
                    WHERE id = id_mas_antiguo_reg;
                    SET NEW.estado_regular = 2; -- Nuevo en espera
                ELSE
                    SET NEW.estado_regular = 1; -- Primer disponible
                END IF;
            ELSE
                SET NEW.estado_regular = 2; -- Espera (ya hay activo)
            END IF;
        ELSE
            SET NEW.estado_regular = 0; -- Sin disponibilidad
        END IF;
    END IF;
END//

-- Trigger AFTER INSERT para actualizar estados en inventario_talonarios
CREATE TRIGGER actualizar_estados_inventario_despues_entrega
AFTER INSERT ON entrega_talonarios
FOR EACH ROW
BEGIN
    DECLARE registros_activos_pref INT DEFAULT 0;
    DECLARE registros_activos_reg INT DEFAULT 0;

    -- Actualizar estados preferenciales en inventario_talonarios solo si se entregaron talonarios preferenciales
    IF NEW.cantidad_preferenciales > 0 THEN
        -- Cambiar estado_preferencial a 0 solo para registros que llegaron a 0
        UPDATE inventario_talonarios
        SET estado_preferencial = 0
        WHERE cantidad_restante_preferencial = 0 AND estado_preferencial = 1;

        -- Verificar cuántos registros quedan activos después de la actualización
        SELECT COUNT(*) INTO registros_activos_pref
        FROM inventario_talonarios
        WHERE estado_preferencial = 1 AND cantidad_restante_preferencial > 0;

        -- Solo activar el siguiente si NO hay ningún registro activo con disponibilidad
        IF registros_activos_pref = 0 THEN
            UPDATE inventario_talonarios
            SET estado_preferencial = 1
            WHERE estado_preferencial = 2 AND cantidad_restante_preferencial > 0
            ORDER BY id ASC
            LIMIT 1;
        END IF;
    END IF;

    -- Actualizar estados regulares en inventario_talonarios solo si se entregaron talonarios regulares
    IF NEW.cantidad_regulares > 0 THEN
        -- Cambiar estado_regular a 0 solo para registros que llegaron a 0
        UPDATE inventario_talonarios
        SET estado_regular = 0
        WHERE cantidad_restante_regular = 0 AND estado_regular = 1;

        -- Verificar cuántos registros quedan activos después de la actualización
        SELECT COUNT(*) INTO registros_activos_reg
        FROM inventario_talonarios
        WHERE estado_regular = 1 AND cantidad_restante_regular > 0;

        -- Solo activar el siguiente si NO hay ningún registro activo con disponibilidad
        IF registros_activos_reg = 0 THEN
            UPDATE inventario_talonarios
            SET estado_regular = 1
            WHERE estado_regular = 2 AND cantidad_restante_regular > 0
            ORDER BY id ASC
            LIMIT 1;
        END IF;
    END IF;
END //

DELIMITER ;
