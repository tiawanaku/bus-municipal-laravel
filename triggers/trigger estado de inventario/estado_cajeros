DELIMITER //

CREATE TRIGGER tr_before_insert_entrega_talonarios
BEFORE INSERT ON entrega_talonarios
FOR EACH ROW
BEGIN
    -- Este trigger ahora es más simple ya que la lógica compleja
    -- se maneja en el procedimiento almacenado
    
    -- Solo asegurar que los estados sean 0 si no hay talonarios
    IF NEW.cantidad_restante_preferencial <= 0 THEN
        SET NEW.estado_preferencial = 0;
    END IF;
    
    IF NEW.cantidad_restante_regular <= 0 THEN
        SET NEW.estado_regular = 0;
    END IF;
END //

DELIMITER ;