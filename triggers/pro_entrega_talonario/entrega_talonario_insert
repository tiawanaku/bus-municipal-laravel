DELIMITER //

CREATE PROCEDURE sp_entregar_talonarios(
    IN p_cajero_id INT,
    IN p_inventario_id INT,
    IN p_preferencial_del INT,
    IN p_preferencial_al INT,
    IN p_cantidad_preferenciales INT,
    IN p_rango_inicial_preferencial INT,
    IN p_regular_del INT,
    IN p_regular_al INT,
    IN p_cantidad_regulares INT,
    IN p_rango_inicial_regular INT,
    IN p_tipo_talonario VARCHAR(50),
    IN p_fecha DATE,
    IN p_observaciones TEXT
)
BEGIN
    DECLARE v_total_boletos_pref INT DEFAULT 0;
    DECLARE v_total_boletos_reg INT DEFAULT 0;
    DECLARE v_total_bs_pref DECIMAL(10,2) DEFAULT 0;
    DECLARE v_total_bs_reg DECIMAL(10,2) DEFAULT 0;
    DECLARE v_total_recaudacion DECIMAL(10,2) DEFAULT 0;
    
    DECLARE v_inventario_id_pref INT DEFAULT NULL;
    DECLARE v_inventario_id_reg INT DEFAULT NULL;
    DECLARE v_cant_entregada_pref INT DEFAULT 0;
    DECLARE v_cant_entregada_reg INT DEFAULT 0;
    
    DECLARE v_done INT DEFAULT FALSE;
    DECLARE v_cur_inv_id INT;
    DECLARE v_cur_pref_rest INT;
    DECLARE v_cur_reg_rest INT;
    
    -- Cursor para inventarios disponibles (FIFO)
    DECLARE cur_inventarios CURSOR FOR
        SELECT id, cantidad_restante_preferencial, cantidad_restante_regular
        FROM inventario_talonarios
        WHERE (cantidad_restante_preferencial > 0 AND estado_preferencial = 1 AND p_cantidad_preferenciales > 0)
           OR (cantidad_restante_regular > 0 AND estado_regular = 1 AND p_cantidad_regulares > 0)
        ORDER BY created_at ASC;
    
    DECLARE CONTINUE HANDLER FOR NOT FOUND SET v_done = TRUE;
    
    -- Validaciones básicas
    IF (p_cantidad_preferenciales IS NULL OR p_cantidad_preferenciales < 0) 
       AND (p_cantidad_regulares IS NULL OR p_cantidad_regulares < 0) THEN
        SIGNAL SQLSTATE '45000' 
        SET MESSAGE_TEXT = 'Debe especificar al menos una cantidad válida de talonarios';
    END IF;
    
    -- Calcular totales
    IF p_cantidad_preferenciales > 0 THEN
        SET v_total_boletos_pref = p_cantidad_preferenciales * 50;
        SET v_total_bs_pref = v_total_boletos_pref * 1.00;
    END IF;
    
    IF p_cantidad_regulares > 0 THEN
        SET v_total_boletos_reg = p_cantidad_regulares * 50;
        SET v_total_bs_reg = v_total_boletos_reg * 1.50;
    END IF;
    
    SET v_total_recaudacion = v_total_bs_pref + v_total_bs_reg;
    
    -- Procesar talonarios preferenciales
    IF p_cantidad_preferenciales > 0 THEN
        SET v_done = FALSE;
        OPEN cur_inventarios;
        
        pref_loop: LOOP
            FETCH cur_inventarios INTO v_cur_inv_id, v_cur_pref_rest, v_cur_reg_rest;
            IF v_done OR p_cantidad_preferenciales <= 0 THEN
                LEAVE pref_loop;
            END IF;
            
            IF v_cur_pref_rest > 0 THEN
                -- Registrar el primer inventario usado para la relación
                IF v_inventario_id_pref IS NULL THEN
                    SET v_inventario_id_pref = v_cur_inv_id;
                END IF;
                
                -- Calcular cantidad a entregar de este inventario
                IF v_cur_pref_rest >= p_cantidad_preferenciales THEN
                    UPDATE inventario_talonarios
                    SET cantidad_restante_preferencial = cantidad_restante_preferencial - p_cantidad_preferenciales
                    WHERE id = v_cur_inv_id;
                    
                    SET v_cant_entregada_pref = v_cant_entregada_pref + p_cantidad_preferenciales;
                    SET p_cantidad_preferenciales = 0;
                ELSE
                    UPDATE inventario_talonarios
                    SET cantidad_restante_preferencial = 0
                    WHERE id = v_cur_inv_id;
                    
                    SET v_cant_entregada_pref = v_cant_entregada_pref + v_cur_pref_rest;
                    SET p_cantidad_preferenciales = p_cantidad_preferenciales - v_cur_pref_rest;
                END IF;
            END IF;
        END LOOP;
        
        CLOSE cur_inventarios;
        
        -- Si no se pudo entregar todo
        IF p_cantidad_preferenciales > 0 THEN
            -- Corrección: Usar CONCAT correctamente en SIGNAL
            SET @error_msg = CONCAT('No hay suficientes talonarios preferenciales disponibles. Faltan: ', p_cantidad_preferenciales);
            SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = @error_msg;
        END IF;
    END IF;
    
    -- Procesar talonarios regulares
    IF p_cantidad_regulares > 0 THEN
        SET v_done = FALSE;
        OPEN cur_inventarios;
        
        reg_loop: LOOP
            FETCH cur_inventarios INTO v_cur_inv_id, v_cur_pref_rest, v_cur_reg_rest;
            IF v_done OR p_cantidad_regulares <= 0 THEN
                LEAVE reg_loop;
            END IF;
            
            IF v_cur_reg_rest > 0 THEN
                -- Registrar el primer inventario usado para la relación
                IF v_inventario_id_reg IS NULL THEN
                    SET v_inventario_id_reg = v_cur_inv_id;
                END IF;
                
                -- Calcular cantidad a entregar de este inventario
                IF v_cur_reg_rest >= p_cantidad_regulares THEN
                    UPDATE inventario_talonarios
                    SET cantidad_restante_regular = cantidad_restante_regular - p_cantidad_regulares
                    WHERE id = v_cur_inv_id;
                    
                    SET v_cant_entregada_reg = v_cant_entregada_reg + p_cantidad_regulares;
                    SET p_cantidad_regulares = 0;
                ELSE
                    UPDATE inventario_talonarios
                    SET cantidad_restante_regular = 0
                    WHERE id = v_cur_inv_id;
                    
                    SET v_cant_entregada_reg = v_cant_entregada_reg + v_cur_reg_rest;
                    SET p_cantidad_regulares = p_cantidad_regulares - v_cur_reg_rest;
                END IF;
            END IF;
        END LOOP;
        
        CLOSE cur_inventarios;
        
        -- Si no se pudo entregar todo
        IF p_cantidad_regulares > 0 THEN
            -- Corrección: Usar CONCAT correctamente en SIGNAL
            SET @error_msg = CONCAT('No hay suficientes talonarios regulares disponibles. Faltan: ', p_cantidad_regulares);
            SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = @error_msg;
        END IF;
    END IF;
    
    -- Insertar registro de entrega
    INSERT INTO entrega_talonarios (
        inventario_id,
        cajero_id,
        preferencial_del,
        preferencial_al,
        cantidad_preferenciales,
        rango_inicial_preferencial,
        rango_final_preferencial,
        total_boletos_preferenciales,
        total_aproximado_bolivianos_preferencial,
        cantidad_restante_preferencial,
        regular_del,
        regular_al,
        cantidad_regulares,
        rango_inicial_regular,
        rango_final_regular,
        total_boletos_regulares,
        total_aproximado_bolivianos_regular,
        cantidad_restante_regular,
        estado_preferencial,
        estado_regular,
        tipo_talonario,
        fecha_entrega,
        observaciones,
        total_recaudacion_bolivianos,
        created_at,
        updated_at
    ) VALUES (
        COALESCE(v_inventario_id_pref, v_inventario_id_reg),
        p_cajero_id,
        p_preferencial_del,
        p_preferencial_al,
        v_cant_entregada_pref,
        p_rango_inicial_preferencial,
        p_rango_inicial_preferencial + (v_cant_entregada_pref * 50) - 1,
        v_total_boletos_pref,
        v_total_bs_pref,
        v_cant_entregada_pref,
        p_regular_del,
        p_regular_al,
        v_cant_entregada_reg,
        p_rango_inicial_regular,
        p_rango_inicial_regular + (v_cant_entregada_reg * 50) - 1,
        v_total_boletos_reg,
        v_total_bs_reg,
        v_cant_entregada_reg,
        0,
        0,
        p_tipo_talonario,
        p_fecha,
        p_observaciones,
        v_total_recaudacion,
        NOW(),
        NOW()
    );
    
    -- Actualizar estados de inventarios
    CALL sp_actualizar_estados_inventarios();
    
    SELECT LAST_INSERT_ID() AS id_entrega;
END //

DELIMITER ;