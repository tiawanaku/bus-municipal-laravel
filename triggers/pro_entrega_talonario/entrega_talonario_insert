DELIMITER //

CREATE PROCEDURE entregar_talonarios (
    IN p_cajero_id INT,
    IN P_inventario_id INT, -- ya no se usa directamente, pero se mantiene por compatibilidad
    IN p_preferencial_del INT,
    IN p_preferencial_al INT,
    IN p_cantidad_preferenciales INT,
    IN p_rango_inicial_preferencial INT,
    IN p_regular_del INT,
    IN p_regular_al INT,
    IN p_cantidad_regulares INT,
    IN p_rango_inicial_regular INT,
    IN p_tipo_talonario VARCHAR(50),   -- nuevo parámetro varchar
    IN p_fecha DATE,
    IN p_observaciones TEXT
)
BEGIN
    DECLARE cantidad_total_preferenciales INT DEFAULT 0;
    DECLARE cantidad_total_regulares INT DEFAULT 0;
    DECLARE cantidad_original_preferenciales INT DEFAULT 0;
    DECLARE cantidad_original_regulares INT DEFAULT 0;
    DECLARE rango_final_preferencial INT DEFAULT 0;
    DECLARE rango_final_regular INT DEFAULT 0;

    DECLARE total_boletos_preferenciales INT DEFAULT 0;
    DECLARE total_boletos_regulares INT DEFAULT 0;
    DECLARE total_estimado_preferenciales DECIMAL(10,2) DEFAULT 0;
    DECLARE total_estimado_regulares DECIMAL(10,2) DEFAULT 0;
    DECLARE total_estimado_general DECIMAL(10,2) DEFAULT 0;

    DECLARE done INT DEFAULT FALSE;
    DECLARE inv_id INT;
    DECLARE inv_cantidad_pref INT;
    DECLARE inv_cantidad_reg INT;

    DECLARE primer_inventario_id INT DEFAULT NULL;

    -- Variables para calcular cantidades basadas en rangos
    DECLARE cantidad_calculada_preferenciales INT DEFAULT 0;
    DECLARE cantidad_calculada_regulares INT DEFAULT 0;

    DECLARE cur CURSOR FOR
        SELECT id, cantidad_restante_preferencial, cantidad_restante_regular
        FROM inventario_talonarios
        WHERE (cantidad_restante_preferencial > 0 AND estado_preferencial = 1)
           OR (cantidad_restante_regular > 0 AND estado_regular = 1)
        ORDER BY id ASC;

    DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = TRUE;

    -- Calcular cantidades basadas en rangos si están definidos
    IF p_preferencial_del > 0 AND p_preferencial_al > 0 THEN
        SET cantidad_calculada_preferenciales = p_preferencial_al - p_preferencial_del + 1;
        IF p_cantidad_preferenciales > 0 THEN
            SET cantidad_total_preferenciales = p_cantidad_preferenciales;
        ELSE
            SET cantidad_total_preferenciales = cantidad_calculada_preferenciales;
        END IF;
    ELSE
        SET cantidad_total_preferenciales = p_cantidad_preferenciales;
    END IF;

    IF p_regular_del > 0 AND p_regular_al > 0 THEN
        SET cantidad_calculada_regulares = p_regular_al - p_regular_del + 1;
        IF p_cantidad_regulares > 0 THEN
            SET cantidad_total_regulares = p_cantidad_regulares;
        ELSE
            SET cantidad_total_regulares = cantidad_calculada_regulares;
        END IF;
    ELSE
        SET cantidad_total_regulares = p_cantidad_regulares;
    END IF;

    -- Guardar las cantidades originales para el INSERT
    SET cantidad_original_preferenciales = cantidad_total_preferenciales;
    SET cantidad_original_regulares = cantidad_total_regulares;

    -- Calcular rangos y totales si hay cantidades preferenciales
    IF cantidad_total_preferenciales > 0 THEN
        SET rango_final_preferencial = p_rango_inicial_preferencial + (cantidad_total_preferenciales * 50) - 1;
        SET total_boletos_preferenciales = cantidad_total_preferenciales * 50;
        SET total_estimado_preferenciales = total_boletos_preferenciales * 1.00;
    END IF;

    -- Calcular rangos y totales si hay cantidades regulares
    IF cantidad_total_regulares > 0 THEN
        SET rango_final_regular = p_rango_inicial_regular + (cantidad_total_regulares * 50) - 1;
        SET total_boletos_regulares = cantidad_total_regulares * 50;
        SET total_estimado_regulares = total_boletos_regulares * 1.50;
    END IF;

    SET total_estimado_general = total_estimado_preferenciales + total_estimado_regulares;

    -- Repartir talonarios preferenciales
    IF cantidad_total_preferenciales > 0 THEN
        SET done = FALSE;
        OPEN cur;
        read_loop_pref: LOOP
            FETCH cur INTO inv_id, inv_cantidad_pref, inv_cantidad_reg;
            IF done THEN
                LEAVE read_loop_pref;
            END IF;

            IF cantidad_total_preferenciales > 0 AND inv_cantidad_pref > 0 THEN
                IF primer_inventario_id IS NULL THEN
                    SET primer_inventario_id = inv_id;
                END IF;

                IF inv_cantidad_pref >= cantidad_total_preferenciales THEN
                    UPDATE inventario_talonarios
                    SET cantidad_restante_preferencial = cantidad_restante_preferencial - cantidad_total_preferenciales
                    WHERE id = inv_id;
                    SET cantidad_total_preferenciales = 0;
                ELSE
                    UPDATE inventario_talonarios
                    SET cantidad_restante_preferencial = 0
                    WHERE id = inv_id;
                    SET cantidad_total_preferenciales = cantidad_total_preferenciales - inv_cantidad_pref;
                END IF;
            END IF;
        END LOOP;
        CLOSE cur;
    END IF;

    -- Repartir talonarios regulares
    IF cantidad_total_regulares > 0 THEN
        SET done = FALSE;
        OPEN cur;
        read_loop_reg: LOOP
            FETCH cur INTO inv_id, inv_cantidad_pref, inv_cantidad_reg;
            IF done THEN
                LEAVE read_loop_reg;
            END IF;

            IF cantidad_total_regulares > 0 AND inv_cantidad_reg > 0 THEN
                IF primer_inventario_id IS NULL THEN
                    SET primer_inventario_id = inv_id;
                END IF;

                IF inv_cantidad_reg >= cantidad_total_regulares THEN
                    UPDATE inventario_talonarios
                    SET cantidad_restante_regular = cantidad_restante_regular - cantidad_total_regulares
                    WHERE id = inv_id;
                    SET cantidad_total_regulares = 0;
                ELSE
                    UPDATE inventario_talonarios
                    SET cantidad_restante_regular = 0
                    WHERE id = inv_id;
                    SET cantidad_total_regulares = cantidad_total_regulares - inv_cantidad_reg;
                END IF;
            END IF;
        END LOOP;
        CLOSE cur;
    END IF;

    -- Insertar registro en entrega_talonarios
    INSERT INTO entrega_talonarios (
        inventario_id,
        cajero_id,
        preferencial_del,
        preferencial_al,
        cantidad_preferenciales,
        rango_inicial_preferencial,
        rango_final_preferencial,
        total_boletos_preferenciales,
        total_aproximado_bolivianos_preferencial,
        cantidad_restante_preferencial,
        regular_del,
        regular_al,
        cantidad_regulares,
        rango_inicial_regular,
        rango_final_regular,
        total_boletos_regulares,
        total_aproximado_bolivianos_regular,
        cantidad_restante_regular,
        estado_preferencial,
        estado_regular,
        tipo_talonario,
        fecha_entrega,
        observaciones,
        total_recaudacion_bolivianos,
        created_at,
        updated_at
    ) VALUES (
        primer_inventario_id,
        p_cajero_id,
        p_preferencial_del,
        p_preferencial_al,
        cantidad_original_preferenciales - cantidad_total_preferenciales, -- Cantidad real entregada
        p_rango_inicial_preferencial,
        rango_final_preferencial,
        total_boletos_preferenciales,
        total_estimado_preferenciales,
        cantidad_original_preferenciales - cantidad_total_preferenciales, -- Cantidad entregada (mismo valor que cantidad_preferenciales)
        p_regular_del,
        p_regular_al,
        cantidad_original_regulares - cantidad_total_regulares, -- Cantidad real entregada
        p_rango_inicial_regular,
        rango_final_regular,
        total_boletos_regulares,
        total_estimado_regulares,
        cantidad_original_regulares - cantidad_total_regulares, -- Cantidad entregada (mismo valor que cantidad_regulares)
        0,
        0,
        p_tipo_talonario,
        p_fecha,
        p_observaciones,
        total_estimado_general,
        NOW(),
        NOW()
    );

    -- Los estados se actualizarán automáticamente mediante el trigger

END //

DELIMITER ;
