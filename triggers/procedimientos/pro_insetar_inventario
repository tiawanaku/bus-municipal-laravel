DELIMITER $$

CREATE PROCEDURE inventario_talonarios (
    IN p_cajero_id BIGINT UNSIGNED,
    IN p_cantidad_preferenciales INT,
    IN p_rango_inicial_preferencial INT,
    IN p_cantidad_regulares INT,
    IN p_rango_inicial_regular INT,
    IN p_fecha_entrega DATE,
    IN p_observaciones VARCHAR(255),

    -- Nuevos campos PDF y cita
    IN p_cite_nota_solicitud VARCHAR(255),
    IN p_cite_nota_solicitud_filename VARCHAR(255),
    IN p_n_cite VARCHAR(255),
    IN p_gestion VARCHAR(255),
    IN p_n_dosificacion VARCHAR(255),
    IN p_numero_autorizacion VARCHAR(255),
    IN p_fecha_solicitud_dosificacion DATE,
    IN p_fecha_autorizacion DATE,
    IN p_fecha_activacion DATE,

    -- Nuevos rangos (números de talonarios)
    IN p_regular_del INT,        -- Talonario número inicial
    IN p_regular_al INT,         -- Talonario número final
    IN p_preferencial_del INT,   -- Talonario número inicial
    IN p_preferencial_al INT     -- Talonario número final
)
BEGIN
    DECLARE v_rango_final_preferencial INT DEFAULT 0;
    DECLARE v_total_boletos_preferenciales INT DEFAULT 0;
    DECLARE v_total_bs_preferenciales DECIMAL(10,2) DEFAULT 0.00;

    DECLARE v_rango_final_regular INT DEFAULT 0;
    DECLARE v_total_boletos_regulares INT DEFAULT 0;
    DECLARE v_total_bs_regulares DECIMAL(10,2) DEFAULT 0.00;

    DECLARE v_total_recaudar DECIMAL(10,2) DEFAULT 0.00;
    
    -- Variables para las cantidades de talonarios calculadas desde los rangos
    DECLARE v_cantidad_talonarios_preferenciales_calculada INT DEFAULT 0;
    DECLARE v_cantidad_talonarios_regulares_calculada INT DEFAULT 0;
    DECLARE v_cantidad_preferenciales_final INT DEFAULT 0;
    DECLARE v_cantidad_regulares_final INT DEFAULT 0;

    -- ✅ CORRECCIÓN: Del y Al son números de talonarios, no de tickets
    -- Calcular cuántos talonarios hay en el rango
    IF p_preferencial_del > 0 AND p_preferencial_al > 0 AND p_preferencial_al >= p_preferencial_del THEN
        SET v_cantidad_talonarios_preferenciales_calculada = p_preferencial_al - p_preferencial_del + 1;
    END IF;

    IF p_regular_del > 0 AND p_regular_al > 0 AND p_regular_al >= p_regular_del THEN
        SET v_cantidad_talonarios_regulares_calculada = p_regular_al - p_regular_del + 1;
    END IF;

    -- Usar las cantidades de talonarios calculadas si están disponibles, de lo contrario usar las proporcionadas
    SET v_cantidad_preferenciales_final = CASE 
        WHEN v_cantidad_talonarios_preferenciales_calculada > 0 THEN v_cantidad_talonarios_preferenciales_calculada
        ELSE p_cantidad_preferenciales
    END;

    SET v_cantidad_regulares_final = CASE 
        WHEN v_cantidad_talonarios_regulares_calculada > 0 THEN v_cantidad_talonarios_regulares_calculada
        ELSE p_cantidad_regulares
    END;

    -- Calcular valores para boletos preferenciales
    IF v_cantidad_preferenciales_final > 0 THEN
        SET v_rango_final_preferencial = p_rango_inicial_preferencial + (v_cantidad_preferenciales_final * 50) - 1;
        SET v_total_boletos_preferenciales = v_cantidad_preferenciales_final * 50; -- Cada talonario = 50 tickets
        SET v_total_bs_preferenciales = v_total_boletos_preferenciales * 1.00;
    END IF;

    -- Calcular valores para boletos regulares
    IF v_cantidad_regulares_final > 0 THEN
        SET v_rango_final_regular = p_rango_inicial_regular + (v_cantidad_regulares_final * 50) - 1;
        SET v_total_boletos_regulares = v_cantidad_regulares_final * 50; -- Cada talonario = 50 tickets
        SET v_total_bs_regulares = v_total_boletos_regulares * 1.50;
    END IF;

    SET v_total_recaudar = v_total_bs_preferenciales + v_total_bs_regulares;

    INSERT INTO inventario_talonarios (
        cajero_id,
        cantidad_preferenciales,        -- Cantidad de TALONARIOS preferenciales
        rango_inicial_preferencial,
        rango_final_preferencial,
        total_boletos_preferenciales,   -- Total de TICKETS (talonarios × 50)
        total_aproximado_bolivianos_preferencial,
        cantidad_restante_preferencial, -- Talonarios restantes
        cantidad_regulares,             -- Cantidad de TALONARIOS regulares
        rango_inicial_regular,
        rango_final_regular,
        total_boletos_regulares,        -- Total de TICKETS (talonarios × 50)
        total_aproximado_bolivianos_regular,
        cantidad_restante_regular,      -- Talonarios restantes
        estado_preferencial,
        estado_regular,
        tipo_talonarios,
        fecha_entrega,
        observaciones,
        total_recaudacion_bolivianos,
        created_at,
        updated_at,

        -- Nuevos campos PDF y cita
        cite_nota_solicitud,
        cite_nota_solicitud_filename,
        n_cite,
        gestion,
        n_dosificacion,
        numero_autorizacion,
        fecha_solicitud_dosificacion,
        fecha_autorizacion,
        fecha_activacion,

        -- Nuevos rangos de talonarios
        regular_del,
        regular_al,
        preferencial_del,
        preferencial_al
    ) VALUES (
        p_cajero_id,
        v_cantidad_preferenciales_final,  -- Cantidad de TALONARIOS
        p_rango_inicial_preferencial,
        v_rango_final_preferencial,
        v_total_boletos_preferenciales,   -- Total de TICKETS (talonarios × 50)
        v_total_bs_preferenciales,
        v_cantidad_preferenciales_final,  -- Talonarios restantes inicialmente
        v_cantidad_regulares_final,       -- Cantidad de TALONARIOS
        p_rango_inicial_regular,
        v_rango_final_regular,
        v_total_boletos_regulares,        -- Total de TICKETS (talonarios × 50)
        v_total_bs_regulares,
        v_cantidad_regulares_final,       -- Talonarios restantes inicialmente
        NULL,
        NULL,
        'mixto',
        p_fecha_entrega,
        p_observaciones,
        v_total_recaudar,
        NOW(),
        NOW(),

        -- Nuevos valores PDF y cita
        p_cite_nota_solicitud,
        p_cite_nota_solicitud_filename,
        p_n_cite,
        p_gestion,
        p_n_dosificacion,
        p_numero_autorizacion,
        p_fecha_solicitud_dosificacion,
        p_fecha_autorizacion,
        p_fecha_activacion,

        -- Nuevos valores rangos de talonarios
        p_regular_del,
        p_regular_al,
        p_preferencial_del,
        p_preferencial_al
    );
END$$

DELIMITER ;