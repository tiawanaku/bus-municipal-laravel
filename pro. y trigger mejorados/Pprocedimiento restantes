-- 12. FUNCIÓN: SIGUIENTE NÚMERO CORRELATIVO
-- =====================================================
DELIMITER $$

DROP FUNCTION IF EXISTS FN_SiguienteNumeroCorrelativo$$

CREATE FUNCTION FN_SiguienteNumeroCorrelativo(
    p_entrega_anfitrion_id INT,
    p_tipo_ticket VARCHAR(20)
) 
RETURNS INT
READS SQL DATA
DETERMINISTIC
BEGIN
    DECLARE v_siguiente_numero INT;
    DECLARE v_rango_inicial INT;
    DECLARE v_total_vendido INT;
    
    IF p_tipo_ticket = 'PREFERENCIAL' THEN
        SELECT 
            eta.rango_inicial_preferencial,
            COALESCE(SUM(fr.cantidad_ventas_preferenciales), 0)
        INTO v_rango_inicial, v_total_vendido
        FROM entrega_talonarios_anfitrion eta
        LEFT JOIN formulario_recaudo fr ON eta.id = fr.entrega_talonario_anfitrion_id
        WHERE eta.id = p_entrega_anfitrion_id;
    ELSE
        SELECT 
            eta.rango_inicial_regular,
            COALESCE(SUM(fr.cantidad_ventas_regulares), 0)
        INTO v_rango_inicial, v_total_vendido
        FROM entrega_talonarios_anfitrion eta
        LEFT JOIN formulario_recaudo fr ON eta.id = fr.entrega_talonario_anfitrion_id
        WHERE eta.id = p_entrega_anfitrion_id;
    END IF;
    
    SET v_siguiente_numero = v_rango_inicial + v_total_vendido;
    
    RETURN v_siguiente_numero;
END$$

