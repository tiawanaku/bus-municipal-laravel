-- 9. PROCEDIMIENTO: AUDITORIA DE CORRELATIVOS
-- =====================================================
DELIMITER $$

DROP PROCEDURE IF EXISTS SP_AuditoriaCorrelativos$$

CREATE PROCEDURE SP_AuditoriaCorrelativos(
    IN p_fecha_inicio DATE,
    IN p_fecha_fin DATE
)
BEGIN
    -- Crear tabla temporal para auditoria
    DROP TEMPORARY TABLE IF EXISTS tmp_auditoria;
    CREATE TEMPORARY TABLE tmp_auditoria (
        anfitrion_id INT,
        anfitrion_nombre VARCHAR(255),
        tipo_ticket VARCHAR(20),
        rango_esperado_inicio INT,
        rango_esperado_fin INT,
        rango_real_inicio INT,
        rango_real_fin INT,
        diferencia INT,
        estado_correlativo VARCHAR(20),
        fecha_venta DATE
    );
    
    -- Auditar correlativos regulares
    INSERT INTO tmp_auditoria
    SELECT 
        fr.anfitrion_id,
        u.name as anfitrion_nombre,
        'REGULAR' as tipo_ticket,
        (eta.rango_inicial_regular + 
         (SELECT COALESCE(SUM(cantidad_ventas_regulares), 0) 
          FROM formulario_recaudo fr2 
          WHERE fr2.entrega_talonario_anfitrion_id = fr.entrega_talonario_anfitrion_id 
          AND fr2.id < fr.id)) as rango_esperado_inicio,
        (eta.rango_inicial_regular + 
         (SELECT COALESCE(SUM(cantidad_ventas_regulares), 0) 
          FROM formulario_recaudo fr2 
          WHERE fr2.entrega_talonario_anfitrion_id = fr.entrega_talonario_anfitrion_id 
          AND fr2.id < fr.id) + fr.cantidad_ventas_regulares - 1) as rango_esperado_fin,
        fr.rango_inicial_regulares as rango_real_inicio,
        fr.rango_final_regulares as rango_real_fin,
        ABS(fr.rango_inicial_regulares - 
            (eta.rango_inicial_regular + 
             (SELECT COALESCE(SUM(cantidad_ventas_regulares), 0) 
              FROM formulario_recaudo fr2 
              WHERE fr2.entrega_talonario_anfitrion_id = fr.entrega_talonario_anfitrion_id 
              AND fr2.id < fr.id))) as diferencia,
        CASE 
            WHEN fr.rango_inicial_regulares = 
                 (eta.rango_inicial_regular + 
                  (SELECT COALESCE(SUM(cantidad_ventas_regulares), 0) 
                   FROM formulario_recaudo fr2 
                   WHERE fr2.entrega_talonario_anfitrion_id = fr.entrega_talonario_anfitrion_id 
                   AND fr2.id < fr.id))
            THEN 'CORRECTO'
            ELSE 'ERROR'
        END as estado_correlativo,
        fr.fecha_recaudo
    FROM formulario_recaudo fr
    JOIN entrega_talonarios_anfitrion eta ON fr.entrega_talonario_anfitrion_id = eta.id
    JOIN users u ON fr.anfitrion_id = u.id
    WHERE fr.fecha_recaudo BETWEEN p_fecha_inicio AND p_fecha_fin
    AND fr.cantidad_ventas_regulares > 0;
    
    -- Auditar correlativos preferenciales
    INSERT INTO tmp_auditoria
    SELECT 
        fr.anfitrion_id,
        u.name as anfitrion_nombre,
        'PREFERENCIAL' as tipo_ticket,
        (eta.rango_inicial_preferencial + 
         (SELECT COALESCE(SUM(cantidad_ventas_preferenciales), 0) 
          FROM formulario_recaudo fr2 
          WHERE fr2.entrega_talonario_anfitrion_id = fr.entrega_talonario_anfitrion_id 
          AND fr2.id < fr.id)) as rango_esperado_inicio,
        (eta.rango_inicial_preferencial + 
         (SELECT COALESCE(SUM(cantidad_ventas_preferenciales), 0) 
          FROM formulario_recaudo fr2 
          WHERE fr2.entrega_talonario_anfitrion_id = fr.entrega_talonario_anfitrion_id 
          AND fr2.id < fr.id) + fr.cantidad_ventas_preferenciales - 1) as rango_esperado_fin,
        fr.rango_inicial_preferencial as rango_real_inicio,
        fr.rango_final_preferencial as rango_real_fin,
        ABS(fr.rango_inicial_preferencial - 
            (eta.rango_inicial_preferencial + 
             (SELECT COALESCE(SUM(cantidad_ventas_preferenciales), 0) 
              FROM formulario_recaudo fr2 
              WHERE fr2.entrega_talonario_anfitrion_id = fr.entrega_talonario_anfitrion_id 
              AND fr2.id < fr.id))) as diferencia,
        CASE 
            WHEN fr.rango_inicial_preferencial = 
                 (eta.rango_inicial_preferencial + 
                  (SELECT COALESCE(SUM(cantidad_ventas_preferenciales), 0) 
                   FROM formulario_recaudo fr2 
                   WHERE fr2.entrega_talonario_anfitrion_id = fr.entrega_talonario_anfitrion_id 
                   AND fr2.id < fr.id))
            THEN 'CORRECTO'
            ELSE 'ERROR'
        END as estado_correlativo,
        fr.fecha_recaudo
    FROM formulario_recaudo fr
    JOIN entrega_talonarios_anfitrion eta ON fr.entrega_talonario_anfitrion_id = eta.id
    JOIN users u ON fr.anfitrion_id = u.id
    WHERE fr.fecha_recaudo BETWEEN p_fecha_inicio AND p_fecha_fin
    AND fr.cantidad_ventas_preferenciales > 0;
    
    -- Mostrar resultados
    SELECT * FROM tmp_auditoria ORDER BY anfitrion_nombre, tipo_ticket, fecha_venta;
    
    -- Resumen de errores
    SELECT 
        'RESUMEN DE AUDITORIA' as seccion,
        COUNT(*) as total_registros,
        SUM(CASE WHEN estado_correlativo = 'ERROR' THEN 1 ELSE 0 END) as total_errores,
        ROUND((SUM(CASE WHEN estado_correlativo = 'ERROR' THEN 1 ELSE 0 END) * 100.0 / COUNT(*)), 2) as porcentaje_error
    FROM tmp_auditoria;
    
END$$

DELIMITER ;

