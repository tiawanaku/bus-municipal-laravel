-- 7. PROCEDIMIENTO: REPORTE DE ESTADO GENERAL
-- =====================================================
DELIMITER $$

DROP PROCEDURE IF EXISTS SP_ReporteEstadoGeneral$$

CREATE PROCEDURE SP_ReporteEstadoGeneral(
    IN p_fecha_inicio DATE,
    IN p_fecha_fin DATE
)
BEGIN
    -- Resumen general
    SELECT 
        'RESUMEN GENERAL' as seccion,
        SUM(total_boletos_preferenciales) as total_tickets_preferenciales_creados,
        SUM(total_boletos_regulares) as total_tickets_regulares_creados,
        SUM(cantidad_restante_preferencial * 50) as tickets_preferenciales_disponibles,
        SUM(cantidad_restante_regular * 50) as tickets_regulares_disponibles,
        SUM(total_recaudacion_bolivianos) as monto_potencial_total
    FROM inventario_talonarios 
    WHERE fecha_entrega BETWEEN p_fecha_inicio AND p_fecha_fin;
    
    -- Ventas realizadas
    SELECT 
        'VENTAS REALIZADAS' as seccion,
        COUNT(*) as total_ventas,
        SUM(cantidad_ventas_preferenciales) as tickets_preferenciales_vendidos,
        SUM(cantidad_ventas_regulares) as tickets_regulares_vendidos,
        SUM(monto_recaudado_preferencial) as recaudo_preferencial,
        SUM(monto_recaudado_regular) as recaudo_regular,
        SUM(total_recaudo_regular_preferencial) as recaudo_total
    FROM formulario_recaudo 
    WHERE fecha_recaudo BETWEEN p_fecha_inicio AND p_fecha_fin;
    
    -- Estado por cajero
    SELECT 
        c.nombres as cajero,
        i.estado,
        COUNT(i.id) as inventarios_activos,
        SUM(i.cantidad_restante_preferencial) as talonarios_pref_disponibles,
        SUM(i.cantidad_restante_regular) as talonarios_reg_disponibles,
        SUM(i.cantidad_restante_preferencial * 50 * 1.00 + i.cantidad_restante_regular * 50 * 1.50) as monto_potencial
    FROM inventario_talonarios i
    JOIN cajeros c ON i.cajero_id = c.id
    WHERE i.fecha_entrega BETWEEN p_fecha_inicio AND p_fecha_fin
    GROUP BY c.id, c.nombres, i.estado
    ORDER BY c.nombres, i.estado;
END$$

DELIMITER ;

-- =====================================================

-- 8. PROCEDIMIENTO: VALIDAR CORRELATIVIDAD
-- =====================================================
DELIMITER $$

DROP PROCEDURE IF EXISTS SP_ValidarCorrelatividad$$

CREATE PROCEDURE SP_ValidarCorrelatividad(
    IN p_entrega_anfitrion_id INT,
    OUT p_resultado BOOLEAN,
    OUT p_mensaje TEXT
)
BEGIN
    DECLARE v_contador INT DEFAULT 0;
    DECLARE v_mensaje_detalle TEXT DEFAULT '';
    DECLARE done INT DEFAULT FALSE;
    DECLARE v_rango_inicial INT;
    DECLARE v_rango_final INT;
    DECLARE v_cantidad_vendida INT;
    DECLARE v_tipo VARCHAR(20);
    
    DECLARE cursor_ventas CURSOR FOR 
        SELECT 
            rango_inicial_regulares, rango_final_regulares, cantidad_ventas_regulares, 'regular' as tipo
        FROM formulario_recaudo 
        WHERE entrega_talonario_anfitrion_id = p_entrega_anfitrion_id AND cantidad_ventas_regulares > 0
        UNION ALL
        SELECT 
            rango_inicial_preferencial, rango_final_preferencial, cantidad_ventas_preferenciales, 'preferencial'
        FROM formulario_recaudo 
        WHERE entrega_talonario_anfitrion_id = p_entrega_anfitrion_id AND cantidad_ventas_preferenciales > 0
        ORDER BY tipo, rango_inicial_regulares;
    
    DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = TRUE;
    
    SET p_resultado = TRUE;
    SET p_mensaje = 'Correlatividad correcta';
    
    OPEN cursor_ventas;
    
    read_loop: LOOP
        FETCH cursor_ventas INTO v_rango_inicial, v_rango_final, v_cantidad_vendida, v_tipo;
        IF done THEN
            LEAVE read_loop;
        END IF;
        
        -- Verificar que el rango final corresponda con la cantidad
        IF v_rango_final != (v_rango_inicial + v_cantidad_vendida - 1) THEN
            SET p_resultado = FALSE;
            SET v_mensaje_detalle = CONCAT(v_mensaje_detalle, 
                'Error en correlatividad ', v_tipo, ': rango ', v_rango_inicial, 
                '-', v_rango_final, ' no corresponde con cantidad ', v_cantidad_vendida, '; ');
        END IF;
        
        SET v_contador = v_contador + 1;
    END LOOP;
    
    CLOSE cursor_ventas;
    
    IF NOT p_resultado THEN
        SET p_mensaje = CONCAT('Errores encontrados: ', v_mensaje_detalle);
    END IF;
    
END$$

DELIMITER ;

