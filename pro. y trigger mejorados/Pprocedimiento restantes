-- 6. PROCEDIMIENTO: CERRAR INVENTARIO CON ARQUEO
-- =====================================================
DELIMITER $$

DROP PROCEDURE IF EXISTS SP_CerrarInventarioConArqueo$$

CREATE PROCEDURE SP_CerrarInventarioConArqueo(
    IN p_inventario_id INT,
    IN p_observaciones_cierre TEXT,
    OUT p_resultado INT,
    OUT p_mensaje VARCHAR(255)
)
BEGIN
    DECLARE v_total_entregado_pref INT DEFAULT 0;
    DECLARE v_total_entregado_reg INT DEFAULT 0;
    DECLARE v_total_vendido_pref INT DEFAULT 0;
    DECLARE v_total_vendido_reg INT DEFAULT 0;
    DECLARE v_total_devuelto_pref INT DEFAULT 0;
    DECLARE v_total_devuelto_reg INT DEFAULT 0;
    DECLARE v_monto_recaudado_real DECIMAL(10,2) DEFAULT 0;
    DECLARE v_monto_esperado DECIMAL(10,2) DEFAULT 0;
    DECLARE v_diferencia DECIMAL(10,2) DEFAULT 0;
    
    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        SET p_resultado = 0;
        SET p_mensaje = 'Error al cerrar inventario';
    END;
    
    START TRANSACTION;
    
    -- Calcular totales entregados
    SELECT 
        COALESCE(SUM(cantidad_preferenciales), 0),
        COALESCE(SUM(cantidad_regulares), 0)
    INTO v_total_entregado_pref, v_total_entregado_reg
    FROM entrega_talonarios 
    WHERE inventario_id = p_inventario_id;
    
    -- Calcular totales vendidos (a través de anfitriones)
    SELECT 
        COALESCE(SUM(fr.cantidad_ventas_preferenciales), 0),
        COALESCE(SUM(fr.cantidad_ventas_regulares), 0),
        COALESCE(SUM(fr.total_recaudo_regular_preferencial), 0)
    INTO v_total_vendido_pref, v_total_vendido_reg, v_monto_recaudado_real
    FROM formulario_recaudo fr
    JOIN entrega_talonarios_anfitrion eta ON fr.entrega_talonario_anfitrion_id = eta.id
    JOIN entrega_talonarios et ON eta.entrega_talonario_id = et.id
    WHERE et.inventario_id = p_inventario_id;
    
    -- Calcular monto esperado
    SET v_monto_esperado = (v_total_vendido_pref * 1.00) + (v_total_vendido_reg * 1.50);
    SET v_diferencia = v_monto_recaudado_real - v_monto_esperado;
    
    -- Cerrar inventario
    UPDATE inventario_talonarios 
    SET 
        estado = 'inactivo',
        fecha_cierre = CURDATE(),
        observaciones_cierre = CONCAT(
            p_observaciones_cierre, 
            ' | ARQUEO: Entregados P:', v_total_entregado_pref, 
            ' R:', v_total_entregado_reg,
            ' | Vendidos P:', v_total_vendido_pref,
            ' R:', v_total_vendido_reg,
            ' | Recaudado: ', v_monto_recaudado_real,
            ' | Esperado: ', v_monto_esperado,
            ' | Diferencia: ', v_diferencia
        ),
        talonarios_vendidos = CEIL(v_total_vendido_pref / 50.0) + CEIL(v_total_vendido_reg / 50.0)
    WHERE id = p_inventario_id;
    
    SET p_resultado = 1;
    SET p_mensaje = CONCAT('Inventario cerrado. Diferencia: ', v_diferencia, ' Bs');
    
    COMMIT;
END$$

DELIMITER ;

