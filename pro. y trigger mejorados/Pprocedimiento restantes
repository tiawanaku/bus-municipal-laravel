-- 13. PROCEDIMIENTO: RECALCULAR TOTALES
-- =====================================================
DELIMITER $$

DROP PROCEDURE IF EXISTS SP_RecalcularTotales$$

CREATE PROCEDURE SP_RecalcularTotales(
    IN p_inventario_id INT,
    OUT p_resultado INT,
    OUT p_mensaje VARCHAR(255)
)
BEGIN
    DECLARE v_total_vendido_pref INT DEFAULT 0;
    DECLARE v_total_vendido_reg INT DEFAULT 0;
    DECLARE v_monto_recaudado DECIMAL(10,2) DEFAULT 0;
    
    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        SET p_resultado = 0;
        SET p_mensaje = 'Error al recalcular totales';
    END;
    
    START TRANSACTION;
    
    -- Recalcular totales vendidos
    SELECT 
        COALESCE(SUM(fr.cantidad_ventas_preferenciales), 0),
        COALESCE(SUM(fr.cantidad_ventas_regulares), 0),
        COALESCE(SUM(fr.total_recaudo_regular_preferencial), 0)
    INTO v_total_vendido_pref, v_total_vendido_reg, v_monto_recaudado
    FROM formulario_recaudo fr
    JOIN entrega_talonarios_anfitrion eta ON fr.entrega_talonario_anfitrion_id = eta.id
    JOIN entrega_talonarios et ON eta.entrega_talonario_id = et.id
    WHERE et.inventario_id = p_inventario_id;
    
    -- Actualizar inventario principal
    UPDATE inventario_talonarios 
    SET 
        talonarios_vendidos = CEIL(v_total_vendido_pref / 50.0) + CEIL(v_total_vendido_reg / 50.0)
    WHERE id = p_inventario_id;
    
    -- Actualizar entregas de anfitriones
    UPDATE entrega_talonarios_anfitrion eta
    JOIN entrega_talonarios et ON eta.entrega_talonario_id = et.id
    SET eta.monto_recaudado_real = (
        SELECT COALESCE(SUM(fr.total_recaudo_regular_preferencial), 0)
        FROM formulario_recaudo fr
        WHERE fr.entrega_talonario_anfitrion_id = eta.id
    )
    WHERE et.inventario_id = p_inventario_id;
    
    SET p_resultado = 1;
    SET p_mensaje = CONCAT('Totales recalculados - Tickets vendidos: ', 
                          v_total_vendido_pref + v_total_vendido_reg, 
                          ' Monto: ', v_monto_recaudado, ' Bs');
    
    COMMIT;
END$$

DELIMITER ;

-- =====================================================

-- 14. PROCEDIMIENTO: LIMPIAR REGISTROS ANTIGUOS  
-- =====================================================
DELIMITER $$

DROP PROCEDURE IF EXISTS SP_LimpiarRegistrosAntiguos$$

CREATE PROCEDURE SP_LimpiarRegistrosAntiguos(
    IN p_dias_antiguedad INT,
    OUT p_resultado INT,
    OUT p_mensaje VARCHAR(255)
)
BEGIN
    DECLARE v_fecha_limite DATE;
    DECLARE v_registros_eliminados INT DEFAULT 0;
    
    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        SET p_resultado = 0;
        SET p_mensaje = 'Error al limpiar registros antiguos';
    END;
    
    START TRANSACTION;
    
    SET v_fecha_limite = DATE_SUB(CURDATE(), INTERVAL p_dias_antiguedad DAY);
    
    -- Contar inventarios antiguos cerrados
    SELECT COUNT(*) INTO v_registros_eliminados
    FROM inventario_talonarios 
    WHERE DATE(fecha_cierre) < v_fecha_limite 
    AND estado = 'inactivo';
    
    SET p_resultado = v_registros_eliminados;
    SET p_mensaje = CONCAT('Se encontraron ', v_registros_eliminados, ' inventarios antiguos cerrados');
    
    COMMIT;
END$$

