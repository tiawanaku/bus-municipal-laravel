-- 10. PROCEDIMIENTO: CONCILIAR INVENTARIOS
-- =====================================================
DELIMITER $$

DROP PROCEDURE IF EXISTS SP_ConciliarInventarios$$

CREATE PROCEDURE SP_ConciliarInventarios(
    IN p_inventario_id INT,
    OUT p_resultado JSON
)
BEGIN
    DECLARE v_resultado JSON;
    
    SELECT JSON_OBJECT(
        'inventario_principal', JSON_OBJECT(
            'id', i.id,
            'preferenciales_creados', i.cantidad_preferenciales,
            'regulares_creados', i.cantidad_regulares,
            'preferenciales_restantes', i.cantidad_restante_preferencial,
            'regulares_restantes', i.cantidad_restante_regular
        ),
        'entregas_cajeros', JSON_ARRAYAGG(
            JSON_OBJECT(
                'entrega_id', et.id,
                'cajero_id', et.cajero_id,
                'preferenciales_entregados', et.cantidad_preferenciales,
                'regulares_entregados', et.cantidad_regulares,
                'preferenciales_restantes', et.cantidad_restante_preferencial,
                'regulares_restantes', et.cantidad_restante_regular,
                'estado', et.estado
            )
        ),
        'entregas_anfitriones', (
            SELECT JSON_ARRAYAGG(
                JSON_OBJECT(
                    'entrega_anfitrion_id', eta.id,
                    'anfitrion_id', eta.anfitrion_id,
                    'preferenciales_entregados', eta.cantidad_preferenciales,
                    'regulares_entregados', eta.cantidad_regulares,
                    'preferenciales_restantes', eta.cantidad_restante_preferencial,
                    'regulares_restantes', eta.cantidad_restante_regular,
                    'monto_recaudado', eta.monto_recaudado_real,
                    'estado', eta.estado
                )
            )
            FROM entrega_talonarios_anfitrion eta
            WHERE eta.entrega_talonario_id IN (
                SELECT id FROM entrega_talonarios WHERE inventario_id = p_inventario_id
            )
        ),
        'ventas_realizadas', (
            SELECT JSON_ARRAYAGG(
                JSON_OBJECT(
                    'recaudo_id', fr.id,
                    'anfitrion_id', fr.anfitrion_id,
                    'fecha_recaudo', fr.fecha_recaudo,
                    'tickets_regulares_vendidos', fr.cantidad_ventas_regulares,
                    'tickets_preferenciales_vendidos', fr.cantidad_ventas_preferenciales,
                    'monto_recaudado', fr.total_recaudo_regular_preferencial,
                    'estado', fr.estado
                )
            )
            FROM formulario_recaudo fr
            JOIN entrega_talonarios_anfitrion eta ON fr.entrega_talonario_anfitrion_id = eta.id
            JOIN entrega_talonarios et ON eta.entrega_talonario_id = et.id
            WHERE et.inventario_id = p_inventario_id
        )
    ) INTO v_resultado
    FROM inventario_talonarios i
    LEFT JOIN entrega_talonarios et ON i.id = et.inventario_id
    WHERE i.id = p_inventario_id
    GROUP BY i.id;
    
    SET p_resultado = v_resultado;
END$$

DELIMITER ;

