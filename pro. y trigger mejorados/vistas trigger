-- Función para calcular eficiencia de venta
DELIMITER $$

DROP FUNCTION IF EXISTS FN_CalcularEficienciaVenta$$

CREATE FUNCTION FN_CalcularEficienciaVenta(
    p_anfitrion_id INT,
    p_fecha_inicio DATE,
    p_fecha_fin DATE
) 
RETURNS DECIMAL(5,2)
READS SQL DATA
DETERMINISTIC
BEGIN
    DECLARE v_tickets_entregados INT DEFAULT 0;
    DECLARE v_tickets_vendidos INT DEFAULT 0;
    DECLARE v_eficiencia DECIMAL(5,2) DEFAULT 0;
    
    -- Calcular tickets entregados al anfitrión
    SELECT COALESCE(SUM((eta.cantidad_preferenciales + eta.cantidad_regulares) * 50), 0)
    INTO v_tickets_entregados
    FROM entrega_talonarios_anfitrion eta
    WHERE eta.anfitrion_id = p_anfitrion_id
    AND eta.fecha_entrega BETWEEN p_fecha_inicio AND p_fecha_fin;
    
    -- Calcular tickets vendidos
    SELECT COALESCE(SUM(fr.cantidad_ventas_preferenciales + fr.cantidad_ventas_regulares), 0)
    INTO v_tickets_vendidos
    FROM formulario_recaudo fr
    WHERE fr.anfitrion_id = p_anfitrion_id
    AND fr.fecha_recaudo BETWEEN p_fecha_inicio AND p_fecha_fin;
    
    IF v_tickets_entregados > 0 THEN
        SET v_eficiencia = (v_tickets_vendidos * 100.0) / v_tickets_entregados;
    END IF;
    
    RETURN v_eficiencia;
END$$

DELIMITER ;

-- =====================================================

-- Función para validar disponibilidad antes de entrega
DELIMITER $$

DROP FUNCTION IF EXISTS FN_ValidarDisponibilidad$$

CREATE FUNCTION FN_ValidarDisponibilidad(
    p_inventario_id INT,
    p_tipo_ticket VARCHAR(20),
    p_cantidad_solicitada INT
) 
RETURNS BOOLEAN
READS SQL DATA
DETERMINISTIC
BEGIN
    DECLARE v_disponible INT DEFAULT 0;
    
    IF p_tipo_ticket = 'PREFERENCIAL' THEN
        SELECT cantidad_restante_preferencial INTO v_disponible
        FROM inventario_talonarios 
        WHERE id = p_inventario_id AND estado = 'disponible';
    ELSE
        SELECT cantidad_restante_regular INTO v_disponible
        FROM inventario_talonarios 
        WHERE id = p_inventario_id AND estado = 'disponible';
    END IF;
    
    RETURN v_disponible >= p_cantidad_solicitada;
END$$

DELIMITER ;

-- =====================================================

-- Función para obtener estado de un ticket específico
DELIMITER $$

DROP FUNCTION IF EXISTS FN_EstadoTicketEspecifico$$

CREATE FUNCTION FN_EstadoTicketEspecifico(p_numero_ticket INT)
RETURNS VARCHAR(50)
READS SQL DATA
DETERMINISTIC
BEGIN
    DECLARE v_estado VARCHAR(50) DEFAULT 'NO_ENCONTRADO';
    
    -- Verificar si el ticket fue vendido
    IF EXISTS (
        SELECT 1 FROM formulario_recaudo 
        WHERE (p_numero_ticket BETWEEN rango_inicial_preferencial AND rango_final_preferencial)
           OR (p_numero_ticket BETWEEN rango_inicial_regulares AND rango_final_regulares)
    ) THEN
        SET v_estado = 'VENDIDO';
    
    -- Verificar si está en inventario de anfitrión
    ELSEIF EXISTS (
        SELECT 1 FROM entrega_talonarios_anfitrion
        WHERE estado = 'activo' 
        AND ((p_numero_ticket BETWEEN rango_inicial_preferencial AND rango_final_preferencial)
             OR (p_numero_ticket BETWEEN rango_inicial_regular AND rango_final_regular))
    ) THEN
        SET v_estado = 'EN_ANFITRION';
        
    -- Verificar si está en inventario de cajero
    ELSEIF EXISTS (
        SELECT 1 FROM entrega_talonarios
        WHERE estado = 'activo'
        AND ((p_numero_ticket BETWEEN rango_inicial_preferencial AND rango_final_preferencial)
             OR (p_numero_ticket BETWEEN rango_inicial_regular AND rango_final_regular))
    ) THEN
        SET v_estado = 'EN_CAJERO';
        
    -- Verificar si está en inventario principal
    ELSEIF EXISTS (
        SELECT 1 FROM inventario_talonarios
        WHERE estado IN ('disponible', 'agotado')
        AND ((p_numero_ticket BETWEEN rango_inicial_preferencial AND rango_final_preferencial)
             OR (p_numero_ticket BETWEEN rango_inicial_regular AND rango_final_regular))
    ) THEN
        SET v_estado = 'EN_INVENTARIO_PRINCIPAL';
    END IF;
    
    RETURN v_estado;
END$$

DELIMITER ;

