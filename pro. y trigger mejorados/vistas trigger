-- VISTAS PARA CONSULTAS RÁPIDAS
-- =====================================================

-- Vista: Estado actual de todos los inventarios
CREATE OR REPLACE VIEW VW_EstadoInventarios AS
SELECT 
    i.id as inventario_id,
    c.nombre as cajero,
    i.cantidad_preferenciales as talonarios_pref_iniciales,
    i.cantidad_regulares as talonarios_reg_iniciales,
    i.cantidad_restante_preferencial as talonarios_pref_disponibles,
    i.cantidad_restante_regular as talonarios_reg_disponibles,
    (i.cantidad_restante_preferencial * 50) as tickets_pref_disponibles,
    (i.cantidad_restante_regular * 50) as tickets_reg_disponibles,
    (i.cantidad_restante_preferencial * 50 * 1.00 + 
     i.cantidad_restante_regular * 50 * 1.50) as monto_potencial,
    i.estado,
    i.fecha_entrega,
    i.fecha_cierre,
    DATEDIFF(COALESCE(i.fecha_cierre, CURDATE()), i.fecha_entrega) as dias_activo
FROM inventario_talonarios i
JOIN cajeros c ON i.cajero_id = c.id
WHERE i.estado != 'inactivo';

-- =====================================================

-- Vista: Resumen de ventas por anfitrión
CREATE OR REPLACE VIEW VW_VentasAnfitrion AS
SELECT 
    u.id as anfitrion_id,
    u.name as anfitrion_nombre,
    COUNT(fr.id) as total_ventas,
    SUM(fr.cantidad_ventas_preferenciales) as tickets_pref_vendidos,
    SUM(fr.cantidad_ventas_regulares) as tickets_reg_vendidos,
    SUM(fr.monto_recaudado_preferencial) as recaudo_preferencial,
    SUM(fr.monto_recaudado_regular) as recaudo_regular,
    SUM(fr.total_recaudo_regular_preferencial) as recaudo_total,
    DATE(MIN(fr.fecha_recaudo)) as primera_venta,
    DATE(MAX(fr.fecha_recaudo)) as ultima_venta,
    ROUND(AVG(fr.total_recaudo_regular_preferencial), 2) as promedio_por_venta,
    COUNT(DISTINCT DATE(fr.fecha_recaudo)) as dias_trabajados
FROM users u
LEFT JOIN formulario_recaudo fr ON u.id = fr.anfitrion_id
GROUP BY u.id, u.name;

-- =====================================================

-- Vista: Control de correlativos por entrega
CREATE OR REPLACE VIEW VW_ControlCorrelativos AS
SELECT 
    eta.id as entrega_anfitrion_id,
    u.name as anfitrion,
    eta.rango_inicial_preferencial,
    eta.rango_final_preferencial,
    eta.rango_inicial_regular,
    eta.rango_final_regular,
    
    -- Próximos números correlativos
    (eta.rango_inicial_preferencial + 
     COALESCE((SELECT SUM(cantidad_ventas_preferenciales) 
               FROM formulario_recaudo 
               WHERE entrega_talonario_anfitrion_id = eta.id), 0)) as proximo_preferencial,
               
    (eta.rango_inicial_regular + 
     COALESCE((SELECT SUM(cantidad_ventas_regulares) 
               FROM formulario_recaudo 
               WHERE entrega_talonario_anfitrion_id = eta.id), 0)) as proximo_regular,
    
    -- Tickets disponibles
    (eta.cantidad_restante_preferencial * 50) as tickets_pref_disponibles,
    (eta.cantidad_restante_regular * 50) as tickets_reg_disponibles,
    
    eta.estado,
    eta.fecha_entrega
FROM entrega_talonarios_anfitrion eta
JOIN users u ON eta.anfitrion_id = u.id
WHERE eta.estado = 'activo';

-- =====================================================

-- Vista: Resumen diario de recaudación
CREATE OR REPLACE VIEW VW_RecaudacionDiaria AS
SELECT 
    DATE(fr.fecha_recaudo) as fecha,
    COUNT(DISTINCT fr.anfitrion_id) as anfitriones_activos,
    COUNT(fr.id) as total_ventas,
    SUM(fr.cantidad_ventas_preferenciales) as tickets_pref_vendidos,
    SUM(fr.cantidad_ventas_regulares) as tickets_reg_vendidos,
    SUM(fr.cantidad_ventas_preferenciales + fr.cantidad_ventas_regulares) as total_tickets_vendidos,
    SUM(fr.monto_recaudado_preferencial) as recaudo_preferencial,
    SUM(fr.monto_recaudado_regular) as recaudo_regular,
    SUM(fr.total_recaudo_regular_preferencial) as recaudo_total_dia,
    ROUND(AVG(fr.total_recaudo_regular_preferencial), 2) as promedio_por_venta
FROM formulario_recaudo fr
GROUP BY DATE(fr.fecha_recaudo)
ORDER BY fecha DESC;

-- =====================================================

-- Vista: Trazabilidad de inventarios
CREATE OR REPLACE VIEW VW_TrazabilidadInventario AS
SELECT 
    i.id as inventario_id,
    'INVENTARIO_PRINCIPAL' as nivel,
    c.nombre as responsable,
    i.cantidad_preferenciales as talonarios_pref,
    i.cantidad_regulares as talonarios_reg,
    i.fecha_entrega as fecha,
    i.estado,
    NULL as parent_id
FROM inventario_talonarios i
JOIN cajeros c ON i.cajero_id = c.id

UNION ALL

SELECT 
    et.inventario_id,
    'ENTREGA_CAJERO' as nivel,
    c.nombre as responsable,
    et.cantidad_preferenciales,
    et.cantidad_regulares,
    et.fecha_entrega,
    et.estado,
    et.inventario_id as parent_id
FROM entrega_talonarios et
JOIN cajeros c ON et.cajero_id = c.id

UNION ALL

SELECT 
    et.inventario_id,
    'ENTREGA_ANFITRION' as nivel,
    u.name as responsable,
    eta.cantidad_preferenciales,
    eta.cantidad_regulares,
    eta.fecha_entrega,
    eta.estado,
    eta.entrega_talonario_id as parent_id
FROM entrega_talonarios_anfitrion eta
JOIN entrega_talonarios et ON eta.entrega_talonario_id = et.id
JOIN users u ON eta.anfitrion_id = u.id;

