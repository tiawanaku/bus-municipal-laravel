-- =====================================================
-- CREAR TABLA DE LOG (OPCIONAL)
-- =====================================================
CREATE TABLE IF NOT EXISTS log_movimientos_talonarios (
    id INT AUTO_INCREMENT PRIMARY KEY,
    tabla_origen VARCHAR(50),
    registro_id INT,
    accion VARCHAR(50),
    datos_json JSON,
    usuario_id INT NULL,
    fecha_movimiento TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    INDEX idx_tabla_fecha (tabla_origen, fecha_movimiento),
    INDEX idx_registro (registro_id),
    INDEX idx_accion (accion),
    INDEX idx_usuario (usuario_id)
);

-- =====================================================
-- TRIGGERS PARA CONTROL AUTOMÁTICO
-- =====================================================

-- Trigger: Actualizar estado de inventario automáticamente
DELIMITER $$

DROP TRIGGER IF EXISTS TR_ActualizarEstadoInventario$$

CREATE TRIGGER TR_ActualizarEstadoInventario
    BEFORE UPDATE ON inventario_talonarios
    FOR EACH ROW
BEGIN
    SET NEW.estado = CASE 
        WHEN NEW.cantidad_restante_preferencial <= 0 AND NEW.cantidad_restante_regular <= 0 
        THEN 'agotado'
        WHEN NEW.cantidad_restante_preferencial > 0 OR NEW.cantidad_restante_regular > 0 
        THEN 'disponible'
        ELSE NEW.estado
    END;
END$$

DELIMITER ;

-- =====================================================

-- Trigger: Log de cambios en ventas
DELIMITER $$

DROP TRIGGER IF EXISTS TR_LogCambiosVentas$$

CREATE TRIGGER TR_LogCambiosVentas
    AFTER INSERT ON formulario_recaudo
    FOR EACH ROW
BEGIN
    INSERT INTO log_movimientos_talonarios (
        tabla_origen, registro_id, accion, datos_json, fecha_movimiento
    ) VALUES (
        'formulario_recaudo', 
        NEW.id, 
        'VENTA_REGISTRADA',
        JSON_OBJECT(
            'anfitrion_id', NEW.anfitrion_id,
            'tickets_regulares', NEW.cantidad_ventas_regulares,
            'tickets_preferenciales', NEW.cantidad_ventas_preferenciales,
            'monto_total', NEW.total_recaudo_regular_preferencial,
            'fecha_recaudo', NEW.fecha_recaudo
        ),
        NOW()
    );
END$$

DELIMITER ;

-- =====================================================

-- Trigger: Log de entregas a anfitriones
DELIMITER $$

DROP TRIGGER IF EXISTS TR_LogEntregasAnfitrion$$

CREATE TRIGGER TR_LogEntregasAnfitrion
    AFTER INSERT ON entrega_talonarios_anfitrion
    FOR EACH ROW
BEGIN
    INSERT INTO log_movimientos_talonarios (
        tabla_origen, registro_id, accion, datos_json, fecha_movimiento
    ) VALUES (
        'entrega_talonarios_anfitrion', 
        NEW.id, 
        'ENTREGA_ANFITRION',
        JSON_OBJECT(
            'anfitrion_id', NEW.anfitrion_id,
            'talonarios_preferenciales', NEW.cantidad_preferenciales,
            'talonarios_regulares', NEW.cantidad_regulares,
            'rango_pref', CONCAT(NEW.rango_inicial_preferencial, '-', NEW.rango_final_preferencial),
            'rango_reg', CONCAT(NEW.rango_inicial_regular, '-', NEW.rango_final_regular)
        ),
        NOW()
    );
END$$

DELIMITER ;

-- =====================================================

-- Trigger: Log de creación de inventarios
DELIMITER $$

DROP TRIGGER IF EXISTS TR_LogCreacionInventario$$

CREATE TRIGGER TR_LogCreacionInventario
    AFTER INSERT ON inventario_talonarios
